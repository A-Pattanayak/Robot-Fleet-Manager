REACT_APP_API_URL=http://127.0.0.1:8000
REACT_APP_ROBOT_SYNC_INTERVAL_MS=60000
REACT_APP_FRONTEND_TELEMETRY_INTERVAL_MS=5000
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
